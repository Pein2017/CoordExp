{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoordExp public_data processed-directory provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relative_path",
    "producer_script",
    "working_dir",
    "command",
    "inputs",
    "key_params",
    "code_ref",
    "generated_at_utc",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "relative_path": {
      "type": "string",
      "pattern": "^public_data/[^/]+(?:/[^/]+)*$"
    },
    "producer_script": {
      "type": "string",
      "minLength": 1
    },
    "working_dir": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "notes"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "key_params": {
      "type": "object"
    },
    "code_ref": {
      "type": ["string", "null"]
    },
    "generated_at_utc": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": "string"
    }
  }
}

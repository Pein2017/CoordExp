{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoordExp public_data provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "relative_path",
    "producer_script",
    "working_dir",
    "command",
    "inputs",
    "key_params",
    "checksums",
    "code_ref",
    "generated_at_utc",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "processed_directory",
        "image_store",
        "annotation_view"
      ]
    },
    "relative_path": {
      "type": "string",
      "pattern": "^public_data/[^/]+(?:/[^/]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "producer_script": {
      "type": "string",
      "minLength": 1
    },
    "working_dir": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "notes"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^|/)\\.\\.(/|$)"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "key_params": {
      "type": "object"
    },
    "checksums": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["scope", "algorithm", "aggregate_sha256", "aggregate_source", "files"],
      "properties": {
        "scope": {
          "type": "string",
          "const": "jsonl_training_samples_only"
        },
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "aggregate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "aggregate_source": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size_bytes", "records"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^public_data/[^/]+(?:/[^/]+)*\\.jsonl$",
                "not": {
                  "pattern": "(^|/)\\.\\.(/|$)"
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "records": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image_store_metadata": {
          "$ref": "#/$defs/sidecar_file"
        },
        "view_metadata": {
          "$ref": "#/$defs/sidecar_file"
        },
        "source_comparison": {
          "$ref": "#/$defs/sidecar_file"
        },
        "length_stats": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sidecar_file"
          }
        }
      }
    },
    "code_ref": {
      "type": ["string", "object", "null"]
    },
    "generated_at_utc": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "sidecar_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^public_data/[^/]+(?:/[^/]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "relative_path": {
            "pattern": "^public_data/[^/]+/images/"
          }
        }
      },
      "then": {
        "required": ["metadata"],
        "properties": {
          "artifact_type": {
            "const": "image_store"
          },
          "checksums": {
            "type": "null"
          },
          "metadata": {
            "required": ["image_store_metadata"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "relative_path": {
            "pattern": "^public_data/[^/]+/views/"
          }
        }
      },
      "then": {
        "required": ["metadata"],
        "properties": {
          "artifact_type": {
            "const": "annotation_view"
          },
          "checksums": {
            "type": "object"
          },
          "metadata": {
            "required": ["view_metadata", "source_comparison"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "relative_path": {
            "not": {
              "pattern": "^public_data/[^/]+/(images|views)/"
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifact_type": {
            "const": "processed_directory"
          },
          "checksums": {
            "type": "object"
          }
        }
      }
    }
  ]
}

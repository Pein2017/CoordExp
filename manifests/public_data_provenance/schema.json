{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoordExp public_data processed-directory provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relative_path",
    "producer_script",
    "working_dir",
    "command",
    "inputs",
    "key_params",
    "checksums",
    "code_ref",
    "generated_at_utc",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "relative_path": {
      "type": "string",
      "pattern": "^public_data/[^/]+(?:/[^/]+)*$"
    },
    "producer_script": {
      "type": "string",
      "minLength": 1
    },
    "working_dir": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "notes"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "key_params": {
      "type": "object"
    },
    "checksums": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["scope", "algorithm", "aggregate_sha256", "aggregate_source", "files"],
      "properties": {
        "scope": {
          "type": "string",
          "const": "jsonl_training_samples_only"
        },
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "aggregate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "aggregate_source": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size_bytes", "records"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^public_data/.*\\.jsonl$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "records": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "code_ref": {
      "type": ["string", "null"]
    },
    "generated_at_utc": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": "string"
    }
  }
}

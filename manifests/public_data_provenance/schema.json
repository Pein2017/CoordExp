{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current recovery or historical identity of public data",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "relative_path",
    "support",
    "origin",
    "checksums",
    "recovery",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_type": {
      "enum": [
        "processed_directory",
        "image_store",
        "annotation_view"
      ]
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
    },
    "support": {
      "enum": [
        "current",
        "historical"
      ]
    },
    "asset_version": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "object",
      "required": [
        "commit",
        "manifest_path",
        "manifest_sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "checksums": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "scope",
            "algorithm",
            "files"
          ],
          "properties": {
            "scope": {
              "const": "jsonl_training_samples_only"
            },
            "algorithm": {
              "const": "sha256"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256",
                  "size_bytes",
                  "records"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "records": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "aggregate_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "aggregate_source": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "metadata": {
      "type": "object"
    },
    "recovery": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "reason"
          ],
          "properties": {
            "mode": {
              "const": "historical_only"
            },
            "reason": {
              "type": "string",
              "minLength": 20
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "module",
            "recipe",
            "raw_archives",
            "environment",
            "image_canaries",
            "image_contract"
          ],
          "properties": {
            "mode": {
              "const": "raw_archives"
            },
            "module": {
              "const": "public_data.recover_coco"
            },
            "recipe": {
              "enum": [
                "pixel-v1",
                "curated-len12000-v1"
              ]
            },
            "raw_archives": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256",
                  "size_bytes",
                  "url"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://images\\.cocodataset\\.org/"
                  }
                },
                "additionalProperties": false
              }
            },
            "environment": {
              "type": "object",
              "required": [
                "python",
                "pillow",
                "libjpeg_turbo"
              ],
              "properties": {
                "python": {
                  "type": "string",
                  "minLength": 1
                },
                "pillow": {
                  "type": "string",
                  "minLength": 1
                },
                "libjpeg_turbo": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "image_canaries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "split",
                  "member",
                  "width",
                  "height",
                  "raw_sha256",
                  "resized_sha256"
                ],
                "properties": {
                  "split": {
                    "enum": [
                      "train",
                      "val"
                    ]
                  },
                  "member": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "raw_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "resized_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "image_contract": {
              "type": "string",
              "minLength": 10
            },
            "annotation_delta": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "support": {
            "const": "current"
          }
        }
      },
      "then": {
        "required": [
          "asset_version"
        ],
        "properties": {
          "checksums": {
            "type": "object"
          },
          "recovery": {
            "properties": {
              "mode": {
                "const": "raw_archives"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "recovery": {
            "properties": {
              "mode": {
                "const": "historical_only"
              }
            }
          }
        }
      }
    }
  ]
}

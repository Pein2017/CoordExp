{
  "baidupcs_bin": "BaiduPCS-Go",
  "local_base": ".",
  "state_dir": "temp/baidudisk-union-sync",
  "node_id_file": ".baidudisk-union-sync-node-id",
  "defaults": {
    "settle_seconds": 600,
    "hash_mode": "size",
    "reject_symlinks": true,
    "reject_special_files": true,
    "reject_unsafe_filenames": true,
    "upload_parallel_files": 8,
    "upload_file_threads": 1,
    "download_parallel_files": 4,
    "download_threads": 8,
    "retry": 8,
    "download_mode": "locate",
    "no_rapid": true
  },
  "roots": {
    "outputs": {
      "local": "outputs",
      "remote": "/CoordExp/outputs",
      "manifest_remote": "/CoordExp/_asset_sync/manifests/outputs",
      "denylist": "configs/asset_sync/deny_upload/outputs.denylist.txt",
      "exclude": [
        "**/.DS_Store",
        "**/.nfs*",
        "**/*.tmp",
        "**/*.part",
        "**/__pycache__/**"
      ]
    }
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks activate --client=codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks remind --client=codex"
          },
          {
            "type": "command",
            "command": "/root/miniconda3/envs/ms/bin/python /data/CoordExp/.codex/hooks/rtk-pretooluse.py",
            "statusMessage": "Checking whether shell output should use RTK"
          }
        ]
      },
      {
        "matcher": "shell",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks remind --client=codex"
          },
          {
            "type": "command",
            "command": "/root/miniconda3/envs/ms/bin/python /data/CoordExp/.codex/hooks/rtk-pretooluse.py",
            "statusMessage": "Checking whether shell output should use RTK"
          }
        ]
      },
      {
        "matcher": "exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks remind --client=codex"
          },
          {
            "type": "command",
            "command": "/root/miniconda3/envs/ms/bin/python /data/CoordExp/.codex/hooks/rtk-pretooluse.py",
            "statusMessage": "Checking whether shell output should use RTK"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks cleanup --client=codex"
          }
        ]
      }
    ]
  }
}

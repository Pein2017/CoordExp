{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/root/miniconda3/envs/ms/bin/python /data/CoordExp/.codex/hooks/rtk-pretooluse.py",
            "statusMessage": "Checking whether shell output should use RTK"
          }
        ]
      },
      {
        "matcher": "shell",
        "hooks": [
          {
            "type": "command",
            "command": "/root/miniconda3/envs/ms/bin/python /data/CoordExp/.codex/hooks/rtk-pretooluse.py",
            "statusMessage": "Checking whether shell output should use RTK"
          }
        ]
      },
      {
        "matcher": "exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "/root/miniconda3/envs/ms/bin/python /data/CoordExp/.codex/hooks/rtk-pretooluse.py",
            "statusMessage": "Checking whether shell output should use RTK"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/data/CoordExp/.shared-memory/.venv/bin/shared-memory --root /data/CoordExp/.shared-memory hook --harness codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
